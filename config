#!/bin/sh
# NAVIN OS 1.0 — live-build configuration (Debian 12 Bookworm, amd64, hybrid ISO)
set -e

lb config noauto \
  --mode debian \
  --distribution bookworm \
  --architectures amd64 \
  --linux-flavours amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --parent-archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --security true \
  --updates true \
  --apt-recommends false \
  --apt-indices false \
  --firmware-chroot true \
  --firmware-binary false \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi,syslinux" \
  --debian-installer none \
  --memtest memtest86+ \
  --chroot-squashfs-compression-type zstd \
  --image-name navin-os \
  --iso-application "NAVIN OS" \
  --iso-publisher "Navin Palecha" \
  --iso-volume "NAVIN_OS_1_0" \
  --bootappend-live "boot=live components persistence quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0 username=navin user-fullname=Navin hostname=navin-os locales=en_US.UTF-8 keyboard-layouts=us" \
  "${@}"
