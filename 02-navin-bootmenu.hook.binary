#!/bin/sh
# NAVIN OS: simple, branded boot menu (GRUB for UEFI, isolinux for BIOS). Runs in the binary tree before the ISO is made.
set +e
for f in boot/grub/grub.cfg boot/grub/config.cfg boot/grub/install_start.cfg; do
  [ -f "$f" ] || continue
  sed -i \
    -e 's/Live system (amd64 fail-safe mode)/NAVIN OS - Safe Graphics Mode/g' \
    -e 's/Live system (amd64)/Start NAVIN OS/g' \
    -e 's/Live system/Start NAVIN OS/g' \
    -e 's/Utilities\.\.\./Tools (Memory test, Hardware)/g' \
    -e 's/^set timeout=.*/set timeout=5/' \
    "$f"
  # fail-safe entry: add nomodeset so it works on problem GPUs
  sed -i '/Safe Graphics/,/initrd/ s/\(linux .*vmlinuz[^ ]*\)/\1 nomodeset/' "$f"
done
grep -q '^set timeout=' boot/grub/grub.cfg 2>/dev/null || sed -i '1i set timeout=5\nset default=0' boot/grub/grub.cfg 2>/dev/null
for f in isolinux/*.cfg; do
  [ -f "$f" ] || continue
  sed -i \
    -e 's/Live system (amd64 fail-safe mode)/NAVIN OS - Safe Graphics Mode/g' \
    -e 's/Live system (amd64)/Start NAVIN OS/g' \
    -e 's/Live system/Start NAVIN OS/g' \
    -e 's/^timeout .*/timeout 50/' \
    "$f"
done
grep -rl 'Debian GNU/Linux' boot/grub isolinux 2>/dev/null | xargs -r sed -i 's#Debian GNU/Linux 12 (bookworm)#NAVIN OS 1.0#g'
echo "[navin-os] boot menu branded"
exit 0
