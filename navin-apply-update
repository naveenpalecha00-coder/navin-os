#!/usr/bin/python3
import os,sys,pathlib,hashlib,tarfile,tempfile,shutil
from navin_logic import safe_patch_path
if os.geteuid()!=0:sys.exit('Administrator privileges required')
if len(sys.argv)!=4:sys.exit('Expected archive, checksum and build')
source=pathlib.Path(sys.argv[1]); digest=sys.argv[2]; build=int(sys.argv[3]); current=int(pathlib.Path('/etc/navin/build').read_text())
if build<=current:sys.exit('Refusing downgrade or duplicate patch')
if source.stat().st_size>100*1024*1024:sys.exit('Patch too large')
# Read once into root-owned staging to prevent caller modifying it after verification.
with tempfile.TemporaryDirectory(prefix='navin-patch-') as folder:
 staged=pathlib.Path(folder)/'patch.tar.gz'; shutil.copyfile(source,staged)
 if hashlib.sha256(staged.read_bytes()).hexdigest()!=digest:sys.exit('Checksum mismatch')
 with tarfile.open(staged) as archive:
  members=archive.getmembers()
  if sum(m.size for m in members)>200*1024*1024:sys.exit('Expanded patch too large')
  for m in members:
   if not m.isfile() or not safe_patch_path(m.name):sys.exit('Unsafe patch entry: '+m.name)
   target=pathlib.Path('/')/m.name
   if target.is_symlink() or any(p.is_symlink() for p in target.parents):sys.exit('Unsafe destination symlink')
  # All files validated before the first write. Back up replaced files.
  backup=pathlib.Path('/var/backups/navin')/str(current); backup.mkdir(parents=True,exist_ok=True)
  for m in members:
   target=pathlib.Path('/')/m.name; old=backup/m.name
   if target.exists():old.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(target,old)
   target.parent.mkdir(parents=True,exist_ok=True)
   stream=archive.extractfile(m)
   if stream is None:sys.exit('Missing file body')
   with open(target,'wb') as f:shutil.copyfileobj(stream,f)
   os.chmod(target,0o755 if m.name.startswith(('usr/local/bin/','usr/local/lib/navin/navin-')) else 0o644)
 pathlib.Path('/etc/navin/build').write_text(str(build)+'\n')
print('NAVIN patch applied. Existing files backed up in /var/backups/navin. Restart when ready.')
