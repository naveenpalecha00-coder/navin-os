#!/bin/sh
# NAVIN 2.2 — live-build configuration (Debian 13 Trixie, amd64, hybrid ISO, UEFI Secure Boot + legacy BIOS)
set -e

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --linux-flavours amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --parent-archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --security true \
  --updates true \
  --apt-recommends false \
  --apt-indices false \
  --firmware-chroot true \
  --firmware-binary false \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi,syslinux" \
  --uefi-secure-boot auto \
  --debian-installer none \
  --memtest memtest86+ \
  --chroot-squashfs-compression-type xz \
  --image-name navin-os \
  --iso-application "NAVIN 2.2" \
  --iso-publisher "Navin Palecha" \
  --iso-volume "NAVIN_2_2" \
  --bootappend-live "boot=live components persistence i8042.nomux=1 i8042.reset=1 quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0 username=navin user-fullname=Navin hostname=navin-os locales=en_US.UTF-8 keyboard-layouts=us" \
  "${@}"
