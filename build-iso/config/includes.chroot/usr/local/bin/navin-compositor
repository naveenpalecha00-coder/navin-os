#!/bin/bash
# NAVIN OS 1.2 window effects (per user).
#   xfwm  (default) xfwm4's own compositor: Alt+Tab shows a live picture of every window, shadows, vsync
#   picom           picom compositor: rounded corners and fades, Alt+Tab shows icons only
#   off             no compositor (fastest)
# The 2 GB "lite" memory profile always runs without a compositor.
# Usage: navin-compositor status | xfwm | picom | off | toggle | apply | suspend
CONF="$HOME/.config/navin/compositor"; mkdir -p "${CONF%/*}"
PROFILE=$(cat /run/navin/memprofile 2>/dev/null || echo standard)
mode(){ local m; m=$(cat "$CONF" 2>/dev/null); case "$m" in xfwm|picom|off) echo "$m";; *) echo xfwm;; esac; }
xf(){ xfconf-query -c xfwm4 -p "/general/$1" -n -t "$2" -s "$3" 2>/dev/null; }
run_xfwm(){ pkill -x picom 2>/dev/null; xf use_compositing bool true; xf cycle_preview bool true; xf cycle_tabwin_mode int 0; xf vblank_mode string auto; }
run_picom(){ xf use_compositing bool false; xf cycle_preview bool false; sleep 0.5; pgrep -x picom >/dev/null || (setsid picom --config /etc/xdg/picom.conf >/dev/null 2>&1 &); }
run_off(){ pkill -x picom 2>/dev/null; xf use_compositing bool false; xf cycle_preview bool false; }
apply(){
  local m; m=$(mode); [ "$PROFILE" = lite ] && m=off
  case "$m" in xfwm) run_xfwm;; picom) run_picom;; off) run_off;; esac
}
case "${1:-status}" in
  status) echo "mode=$(mode) profile=$PROFILE active=$(pgrep -x picom >/dev/null && echo picom || { [ "$(xfconf-query -c xfwm4 -p /general/use_compositing 2>/dev/null)" = true ] && echo xfwm || echo none; })";;
  xfwm|picom|off) echo "$1" > "$CONF"; apply
    case "$1" in xfwm) t="Window previews on (Alt+Tab shows pictures)";; picom) t="Rounded corners on (Alt+Tab shows icons)";; off) t="Window effects off (fastest)";; esac
    [ "$PROFILE" = lite ] && t="2 GB mode: window effects stay off to keep the system fast"
    notify-send -i preferences-desktop-theme "Window effects" "$t" 2>/dev/null;;
  toggle) case "$(mode)" in xfwm) "$0" picom;; picom) "$0" off;; *) "$0" xfwm;; esac;;
  apply) apply;;
  suspend) run_off;;   # Turbo mode: full GPU for the app; "apply" restores the chosen mode
  *) echo "usage: navin-compositor status|xfwm|picom|off|toggle|apply|suspend" >&2; exit 2;;
esac
