#!/bin/bash
# NAVIN AI Assistant — small bottom-center window. Open: hold SPACE 5 s or press Super+Space.
CONF="$HOME/.config/navin/ai.conf"
paplay /usr/share/sounds/freedesktop/stereo/message-new-instant.oga 2>/dev/null &
read -r SW SH < <(xdpyinfo 2>/dev/null | awk '/dimensions:/{split($2,a,"x");print a[1],a[2]}')
W=520; H=170; X=$(( (${SW:-1366}-W)/2 )); Y=$(( ${SH:-768}-H-90 ))
answer() {
  if [ -f "$CONF" ] && grep -q AI_KEY "$CONF"; then . "$CONF"
    B=$(jq -n --arg m "${AI_MODEL:-gpt-4o-mini}" --arg u "$1" '{model:$m,messages:[{role:"system",content:"You are NAVIN AI inside NAVIN OS 1.0 (Debian 12, XFCE) created by Navin Palecha. Reply short and friendly in the user language (Hindi, English, Hinglish, or any other)."},{role:"user",content:$u}]}')
    A=$(curl -s -m 30 "${AI_URL:-https://api.openai.com/v1/chat/completions}" -H "Authorization: Bearer $AI_KEY" -H "Content-Type: application/json" -d "$B" | jq -r '.choices[0].message.content // empty')
    [ -n "$A" ] && { echo "$A"; return; }
  fi
  q=$(echo "$1" | tr 'A-Z' 'a-z')
  case "$q" in
    *navin*os*|*kya*hai*os*|*about*) echo "NAVIN OS 1.0 — Debian 12 par bana fast, light OS. Banane wale: Navin Palecha. Website: navinos.lovable.app" ;;
    *chrome*|*browser*) google-chrome-stable & echo "Chrome khol raha hoon." ;;
    *file*|*folder*) thunar & echo "File Manager khol raha hoon." ;;
    *setting*) navin-settings & echo "Settings khol raha hoon." ;;
    *install*) install-debian & echo "Installer khol raha hoon." ;;
    *exe*|*windows*app*) echo ".exe file par double-click karo — Wine se install hogi aur Start menu me aa jayegi." ;;
    *wifi*|*sound*|*error*|*fix*|*problem*|*slow*) navin-ai-doctor --chat & echo "AI Doctor khol raha hoon jo problem fix karega." ;;
    *) echo "Online jawab ke liye Settings → NAVIN AI me API key daalo. Abhi main apps khol sakta hoon: chrome, files, settings, install, fix." ;;
  esac
}
while Q=$(yad --entry --title="NAVIN AI" --text="<b>Namaste! 👋</b> Kuch bhi poochho…" --undecorated --on-top --skip-taskbar \
  --geometry=${W}x${H}+${X}+${Y} --button="Close:1" --button="Ask:0" --window-icon=/usr/share/pixmaps/navin-os-logo.png); do
  [ -z "$Q" ] && continue
  yad --text-info --wrap --title="NAVIN AI" --undecorated --on-top --skip-taskbar --geometry=${W}x260+${X}+$((Y-90)) \
    --button="Aur poochho:0" --button="Close:1" <<< "$(answer "$Q")" || break
done
