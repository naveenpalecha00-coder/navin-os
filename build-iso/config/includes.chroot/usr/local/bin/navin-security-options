#!/bin/bash
# NAVIN 2.1 Ctrl+Alt+Delete screen (like Windows): Lock · Switch user · Sign out · Change password · Task Manager · Restart · Shut down.
choice=$(zenity --list --title="NAVIN OS" --text="What would you like to do?" --width=360 --height=380 \
  --column=Action "Lock" "Switch user" "Sign out" "Change password" "Task Manager" "Restart" "Shut down" 2>/dev/null) || exit 0
case "$choice" in
  "Lock") xflock4;;
  "Switch user") dm-tool switch-to-greeter;;
  "Sign out") xfce4-session-logout --logout;;
  "Change password") xfce4-terminal --title="Change password" -x bash -c 'passwd; read -rp "Press Enter to close"';;
  "Task Manager") xfce4-taskmanager;;
  "Restart") xfce4-session-logout --reboot;;
  "Shut down") xfce4-session-logout --halt;;
esac
