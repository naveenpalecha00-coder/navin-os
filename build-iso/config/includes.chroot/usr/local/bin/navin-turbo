#!/bin/bash
# NAVIN OS Build 10: 1-click Turbo Mode (performance governor, compositor bypass,
# background throttling, memory compaction). Usage: navin-turbo on|off|toggle|status
set -u
STATE="${XDG_RUNTIME_DIR:-/tmp}/navin-turbo.state"
BG='^(xfce4-clipman|blueman-applet|nm-applet|xfce4-notifyd|navin-session-daemon|tracker-.*|update-notifier)$'

as_root() { sudo -n "$@" 2>/dev/null || pkexec "$@"; }

governor() {
  local want="$1" g
  for g in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
    [ -d "$g" ] || continue
    if grep -qw "$want" "$g/scaling_available_governors" 2>/dev/null; then echo "$want"; return; fi
  done
  echo ""
}

turbo_on() {
  local gov; gov=$(governor performance)
  as_root sh -c "
    [ -n '$gov' ] && for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do echo performance > \$f; done
    for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/energy_performance_preference; do [ -w \$f ] && echo performance > \$f; done
    sync; echo 1 > /proc/sys/vm/drop_caches; echo 1 > /proc/sys/vm/compact_memory
  " || true
  navin-compositor suspend >/dev/null 2>&1   # compositor bypass: full GPU for the game/app
  for p in $(pgrep -u "$USER" -f "$BG" 2>/dev/null); do renice -n 15 -p "$p" >/dev/null 2>&1; done
  echo on > "$STATE"
  notify-send -i dialog-information "NAVIN Turbo" "Turbo ON — maximum speed (more heat & battery use)" 2>/dev/null
}

turbo_off() {
  local gov; gov=$(governor schedutil); [ -n "$gov" ] || gov=$(governor powersave)
  [ -n "$gov" ] && as_root sh -c "for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do echo $gov > \$f; done
    for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/energy_performance_preference; do [ -w \$f ] && echo balance_performance > \$f; done" || true
  navin-compositor apply >/dev/null 2>&1     # restore the chosen window effects
  for p in $(pgrep -u "$USER" -f "$BG" 2>/dev/null); do renice -n 10 -p "$p" >/dev/null 2>&1; done
  rm -f "$STATE"
  notify-send -i dialog-information "NAVIN Turbo" "Balanced mode restored" 2>/dev/null
}

case "${1:-toggle}" in
  on) turbo_on ;;
  off) turbo_off ;;
  status) [ -f "$STATE" ] && echo on || echo off ;;
  toggle) if [ -f "$STATE" ]; then turbo_off; else turbo_on; fi ;;
  *) echo "usage: navin-turbo on|off|toggle|status"; exit 2 ;;
esac
exit 0
