#!/bin/bash
# NAVIN OS login tasks: trust desktop icons (no "untrusted launcher" popup), fix mic, no scroll-to-switch-desktop
for f in "$HOME"/Desktop/*.desktop; do [ -f "$f" ] || continue; chmod +x "$f"; gio set -t string "$f" metadata::xfce-exe-checksum "$(sha256sum "$f" | cut -d' ' -f1)" 2>/dev/null; done
xfconf-query -c xfwm4 -p /general/scroll_workspaces -n -t bool -s false 2>/dev/null
xfconf-query -c xfce4-desktop -p /desktop-icons/single-click -n -t bool -s true 2>/dev/null
navin-mic-fix &
