def t_display(v, out):
    for o, con, mode, prim in T.parse_xrandr(sh(["xrandr", "--query"])):
        if con:
            out.write(f"{o}: connected{' (main)' if prim else ''}, {mode or 'off'}")
    out.write("\nGraphics: " + (sh(["glxinfo", "-B"]) or "glxinfo not available"))


def t_notes(v, out):
    notes = pathlib.Path(HOME, "Documents", "Notes"); notes.mkdir(parents=True, exist_ok=True)
    if v.get("action") == "new note":
        f = notes / time.strftime("Note %Y-%m-%d %H-%M.txt"); f.touch(); subprocess.Popen(["mousepad", str(f)]); out.write(f"New note: {f}"); return
    need(v, "folder")
    other = pathlib.Path(v["folder"]) / "NAVIN Notes"; other.mkdir(parents=True, exist_ok=True)
    m = lambda d: {p.name: p.stat().st_mtime for p in d.glob("*") if p.is_file()}
    to_dst, to_src = T.sync_plan(m(notes), m(other))
    for n in to_dst:
        shutil.copy2(notes / n, other / n)
    for n in to_src:
        shutil.copy2(other / n, notes / n)
    out.write(f"Synced: {len(to_dst)} copied to {other}, {len(to_src)} copied back. Nothing deleted.")


def t_workspace(v, out):
    f = CONF / "workspace.json"
    if v.get("action") == "save":
        def argv(pid):
            try:
                return [a for a in pathlib.Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="replace").split("\0") if a]
            except OSError:
                return []
        sess = T.session_from_windows(T.parse_wmctrl(sh(["wmctrl", "-lpG"])), argv)
        CONF.mkdir(parents=True, exist_ok=True); f.write_text(json.dumps(sess, indent=1))
        out.write(f"Saved {len(sess)} apps:\n" + "\n".join(f"desktop {s['desktop'] + 1}: {' '.join(s['argv'])[:90]}" for s in sess))
        return
    if not f.exists():
        out.write("Nothing saved yet."); return
    for s in json.loads(f.read_text()):
        if which(s["argv"][0]) or os.path.exists(s["argv"][0]):
            subprocess.run(["wmctrl", "-s", str(s["desktop"])]); subprocess.Popen(s["argv"]); time.sleep(1.5)
            out.write("started " + " ".join(s["argv"])[:90])
    out.write("Workspace restored.")


def current_connections():
    return [l.split(":", 1)[0] for l in sh(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"]).splitlines() if ":" in l and "loopback" not in l]


def t_reconnect(v, out):
    names = current_connections()
    if not names:
        out.write("No saved networks."); return
    for n in names:
        run_cmd(T.reconnect_cmd(n.replace("\\:", ":")), out)
    out.write(f"Auto-reconnect on for {len(names)} saved networks: NAVIN keeps retrying until the network is back.")


def t_discover(v, out):
    route = sh(["ip", "-4", "-o", "addr", "show", "scope", "global"]).split()
    cidr = next((route[i + 1] for i, w in enumerate(route) if w == "inet"), None)
    if not cidr:
        out.write("Not connected to a network."); return
    hosts = T.subnet_hosts(cidr)
    out.write(f"Looking for devices on {cidr} ({len(hosts)} addresses) ...")
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(48) as ex:
        list(ex.map(lambda h: subprocess.run(["ping", "-c", "1", "-W", "1", h], capture_output=True), hosts))
    found = T.parse_neigh(sh(["ip", "neigh"]))
    for ip, mac in found:
        try:
            import socket
            name = socket.gethostbyaddr(ip)[0]
        except OSError:
            name = ""
        out.write(f"{ip:16} {mac}  {name}")
    out.write(f"{len(found)} devices found.")


def t_download(v, out):
    need(v, "link")
    folder = os.path.join(HOME, "Downloads"); os.makedirs(folder, exist_ok=True)
    out.write("Downloading (if it breaks, run again with the same link - it continues where it stopped) ...")
    run_cmd(T.download_cmd(v["link"].strip(), folder), out, "Download complete (in Downloads).")


def t_priority(v, out):
    if v.get("network") and v.get("priority"):
        run_cmd(T.priority_cmd(v["network"], v["priority"]), out, "Saved. Higher number = used first.")
    out.write(sh(["nmcli", "-f", "NAME,TYPE,AUTOCONNECT,AUTOCONNECT-PRIORITY", "connection", "show"]))


def t_usbscan(v, out):
    need(v, "folder")
    root = v["folder"]
    rel = [os.path.relpath(p, root) for p, _ in T.walk_files(root, walker=lambda r: os.walk(r))]
    hidden = []
    for d, dirs, files in os.walk(root):
        hidden += [os.path.relpath(os.path.join(d, f), root) for f in files if f.startswith(".")]
    risks = T.usb_risks(sorted(set(rel + hidden)))
    out.write(f"{len(rel)} files checked.")
    for p, why in risks:
        out.write(f"WARNING  {p}: {why}")
    out.write("No risky files found." if not risks else "Do not open these on Windows. Delete them if you did not put them there.")
    if which("clamscan"):
        run_cmd(["clamscan", "-r", "-i", root], out, timeout=3600)


def t_logins(v, out):
    rows = T.failed_logins(sh(["journalctl", "--no-pager", "-q", "-o", "short-iso", "--since", "-30d", "SYSLOG_FACILITY=10", "SYSLOG_FACILITY=4"]))
    out.write(f"Wrong password attempts in the last 30 days: {len(rows)}")
    for when, user in rows[-100:]:
        out.write(f"{when}  user {user}")
    out.write("You also get a notification at login when there were new attempts.")


def t_integrity(v, out):
    if not which("dpkg"):
        out.write("dpkg is not available."); return
    out.write("Checking every installed program file against its package (a few minutes) ...")
    changed = T.parse_dpkg_verify(sh(["dpkg", "--verify"], timeout=1800))
    for p, what in changed[:300]:
        out.write(f"{what:16} {p}")
    out.write(f"{len(changed)} changed program files." if changed else "All program files match their packages.")


def t_permhist(v, out):
    f = DATA / "permissions.json"
    paths = [HOME] + [os.path.join(HOME, n) for n in (".ssh", ".gnupg", ".config/autostart", ".bashrc", ".profile", "Documents", "Desktop", ".navin-vault")]
    entries = []
    for p in paths:
        try:
            st = os.lstat(p); entries.append((p, st.st_mode, st.st_uid))
        except OSError:
            pass
    now = T.perm_snapshot(entries)
    old = json.loads(f.read_text()) if f.exists() else {}
    log = DATA / "permission-changes.log"
    diff = T.perm_diff(old, now) if old else []
    if diff:
        with open(log, "a") as fh:
            for p, a, b in diff:
                fh.write(f"{time.strftime('%Y-%m-%d %H:%M')}  {p}: {a} -> {b}\n")
    DATA.mkdir(parents=True, exist_ok=True); f.write_text(json.dumps(now))
    if not old:
        out.write("First check saved. Changes will be listed here from the next check.")
    else:
        out.write((f"{len(diff)} new change(s) since the last check.\n" if diff else "No permission changes since the last check.\n")
                  + (log.read_text() if log.exists() else ""))


