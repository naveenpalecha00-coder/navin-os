def t_startup(v, out):
    entries = []
    for d in (pathlib.Path(HOME, ".config/autostart"), pathlib.Path("/etc/xdg/autostart")):
        for f in d.glob("*.desktop"):
            ex = next((l.split("=", 1)[1] for l in f.read_text(errors="replace").splitlines() if l.startswith("Exec=")), "")
            entries.append((str(d), f.name, ex))
    cron = sh(["crontab", "-l"])
    entries += [("crontab", "line", l) for l in cron.splitlines() if l.strip() and not l.startswith("#")]
    owned = lambda path: subprocess.run(["dpkg", "-S", path], capture_output=True).returncode == 0
    risks = T.startup_risks(entries, owned)
    out.write(f"{len(entries)} start-up entries checked.")
    for src, name, why in risks:
        out.write(f"CHECK  {name} ({src}): {why}")
    out.write("Nothing suspicious." if not risks else "Remove an entry in Settings > Session and Startup if you do not know it.")


def t_firewall(v, out):
    run_cmd(["pkexec", "ufw", "status", "verbose"], out)
    blocks = T.parse_ufw_blocks(sh(["journalctl", "-k", "--no-pager", "--since", "-7d"]))
    out.write(f"\nBlocked connection attempts (7 days): {sum(n for _, n in blocks)}")
    for (src, proto, port), n in blocks[:40]:
        out.write(f"{n:5}x from {src:18} {proto} port {port}")


def t_audit(v, out):
    ufw = sh(["systemctl", "is-active", "ufw"]).strip() == "active"
    upd = os.path.exists("/etc/apt/apt.conf.d/20auto-upgrades") and "1" in pathlib.Path("/etc/apt/apt.conf.d/20auto-upgrades").read_text()
    sb = sh(["mokutil", "--sb-state"])
    lock = which("light-locker")
    shadow_ok = None  # needs root; report unknown honestly
    ports = T.parse_listening(sh(["ss", "-tulnH"]))
    home = (os.stat(HOME).st_mode & 0o007) == 0
    score, lines = T.audit_score({"firewall": ufw, "updates": upd, "secureboot": ("enabled" in sb) if sb else None,
                                  "lock": lock, "nopass": shadow_ok, "ports": not ports, "homeperm": home})
    out.write(f"Security score: {score} / 100\n")
    for ok, text in lines:
        out.write(("  OK   " if ok else "  ??   " if ok is None else "  FIX  ") + text)
    for proto, addr, port in ports:
        out.write(f"       open: {proto} {addr}:{port}")
    if not home:
        out.write("Fix home folder: chmod 750 ~")


def t_background(v, out):
    import psutil
    wins = {w[2] for w in T.parse_wmctrl(sh(["wmctrl", "-lpG"]))}
    procs = []
    for p in psutil.process_iter(["pid", "name", "uids", "memory_info", "cpu_times"]):
        try:
            i = p.info
            procs.append({"pid": i["pid"], "name": i["name"], "uid": i["uids"].real, "rss": i["memory_info"].rss,
                          "cpu_time": sum(i["cpu_times"][:2]), "has_window": i["pid"] in wins})
        except (psutil.Error, TypeError, AttributeError):
            pass
    out.write("Your programs running without a window (heaviest first):")
    for p in T.rank_processes(procs, os.getuid()):
        out.write(f"{p['pid']:7}  {T.human_size(p['rss']):>9}  CPU {p['cpu_time']:7.1f} s  {p['name']}")
    out.write("\nClose one: Task Manager (Ctrl+Shift+Esc).")


def t_emergency(v, out):
    import psutil
    vm = psutil.virtual_memory()
    procs = []
    for p in psutil.process_iter(["pid", "name", "uids", "memory_info"]):
        try:
            if p.info["uids"].real == os.getuid():
                procs.append({"pid": p.info["pid"], "name": p.info["name"], "rss": p.info["memory_info"].rss})
        except (psutil.Error, AttributeError):
            pass
    out.write(f"Free RAM: {T.human_size(vm.available)} of {T.human_size(vm.total)}")
    targets = T.emergency_targets(procs, vm.available)
    if not targets:
        out.write("Enough memory free. (earlyoom also stops a runaway app automatically before the PC freezes.)"); return
    if confirm("Low memory! Close: " + ", ".join(f"{p['name']} ({T.human_size(p['rss'])})" for p in targets) + " ?"):
        for p in targets:
            try:
                psutil.Process(p["pid"]).terminate(); out.write(f"closed {p['name']}")
            except psutil.Error as e:
                out.write(f"could not close {p['name']}: {e}")


def t_zram(v, out):
    if v.get("profile") and v["profile"] != "show":
        run_cmd(T.zram_profile_cmd(v["profile"]), out, f"Memory profile set to {v['profile']}.")
    for dev, algo, size, data, compr in T.parse_zramctl(sh(["zramctl", "--raw", "--noheadings", "--output", "NAME,ALGORITHM,DISKSIZE,DATA,COMPR"])):
        out.write(f"{dev}: {algo}, size {T.human_size(int(size))}, holds {T.human_size(int(data))} in {T.human_size(int(compr))}")
    out.write("Current profile: " + (pathlib.Path("/run/navin/memprofile").read_text().strip() if os.path.exists("/run/navin/memprofile") else "?"))


def t_cache(v, out):
    c = pathlib.Path(HOME, ".cache")
    total = sum(s for _, s in T.walk_files(str(c))) if c.exists() else 0
    out.write(f"Your cache: {T.human_size(total)}")
    if os.path.exists("/usr/local/lib/navin/navin-history"):
        subprocess.run(["/usr/local/lib/navin/navin-history", "--clean"])
    th = pathlib.Path(HOME, ".cache/thumbnails")
    if v.get("level") == "everything" and th.exists():
        shutil.rmtree(th, ignore_errors=True); out.write("Thumbnails removed (they come back when needed).")
    if v.get("level") == "everything":
        run_cmd(["pkexec", "sh", "-c", "apt-get clean && journalctl --vacuum-size=100M"], out)
    after = sum(s for _, s in T.walk_files(str(c))) if c.exists() else 0
    out.write(f"Now: {T.human_size(after)}  (freed {T.human_size(max(0, total - after))}). This also runs by itself once a week.")


