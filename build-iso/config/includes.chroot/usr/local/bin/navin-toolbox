    ("image", "PDF & Media", "Image Resizer & Converter", "Width in pixels (empty = same size).", [("file", "file"), ("width", "text:"), ("format", "choice:jpg,png,webp,bmp")], t_image),
    ("trim", "PDF & Media", "Video Trimmer", "Cut without re-encoding (fast). Times as HH:MM:SS.", [("file", "file"), ("start", "text:00:00:00"), ("end", "text:00:01:00")], t_trim),
    ("record", "PDF & Media", "Audio Recorder", "Records the microphone into Music.", [("seconds", "text:60")], t_record),
    ("webcam", "PDF & Media", "Webcam Preview", "Opens the camera preview.", [], t_webcam),
    ("dns", "Network", "DNS Speed Check", "Real lookups against 4 public DNS servers.", [("text", "text:debian.org")], t_dns),
    ("netuse", "Network", "Network Usage Monitor", "Measures 5 seconds of traffic.", [], t_netuse),
    ("wifiqr", "Network", "Share Wi-Fi by QR", "Shows a QR code of the current Wi-Fi.", [], t_wifiqr),
    ("nettrouble", "Network", "Internet Troubleshooter", "Checks cable/Wi-Fi, router, internet and DNS step by step.", [], t_nettrouble),
    ("boot", "System", "Startup Time Analyzer", "How long start-up took and what was slowest.", [], t_boot),
    ("services", "System", "Service Manager", "List services; start/stop/restart/enable/disable one (asks for password).", [("service", "text:"), ("action", "choice:show,start,stop,restart,enable,disable")], t_services),
    ("kernel", "System", "Kernel Information", "Kernel version, boot options and loaded drivers.", [], t_kernel),
    ("logs", "System", "Error Log Viewer", "Errors recorded since this start-up.", [], t_logs),
    ("battery", "System", "Battery Health", "Charge, health compared to new, cycles.", [], t_battery),
    ("disk", "System", "Disk Health (SMART)", "Asks the disks for their health (password).", [], t_disk),
    ("usb", "System", "USB Devices", "Everything plugged into USB.", [], t_usb),
    ("report", "System", "System Health Report", "Saves a full report into Documents.", [], t_report),
    ("pomodoro", "Productivity", "Pomodoro Timer", "25 min focus / 5 min break, with notifications.", [("rounds", "text:4")], t_pomodoro),
    ("focus", "Productivity", "Focus Mode", "Silences notifications (run again to turn off).", [], t_focus),
    ("ontop", "Productivity", "Window Always on Top", "Pick a window with the mouse.", [], t_ontop),
    ("keys", "Productivity", "Keyboard Key Tester", "Shows every key you press (Fn keys too).", [], t_keys),
]


def confirm(text):
    ev, res = threading.Event(), {}
    def ask():
        d = Gtk.MessageDialog(message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.OK_CANCEL, text=text)
        res["ok"] = d.run() == Gtk.ResponseType.OK; d.destroy(); ev.set(); return False
    GLib.idle_add(ask); ev.wait(); return res.get("ok", False)


def show_image(path, title):
    w = Gtk.Window(title=title); w.add(Gtk.Image.new_from_file(path)); w.show_all(); return False


def key_tester():
    w = Gtk.Window(title="Keyboard Key Tester"); w.set_default_size(520, 260)
    lab = Gtk.Label(label="Press any key (Fn + F-keys too). Close the window to stop."); lab.set_line_wrap(True)
    hist = []
    def on_key(_w, e):
        name = Gdk.keyval_name(e.keyval) or "?"
        hist.insert(0, f"{name}   (key code {e.hardware_keycode})"); del hist[12:]
        lab.set_markup(f"<big><b>{GLib.markup_escape_text(name)}</b></big>\n\n" + GLib.markup_escape_text("\n".join(hist[1:])))
        return True
    w.connect("key-press-event", on_key); w.add(lab); w.show_all(); return False


class Win(Gtk.Window):
    def __init__(self, start=None):
        super().__init__(title="NAVIN Toolbox"); self.set_default_size(980, 640); self.connect("destroy", Gtk.main_quit)
        prov = Gtk.CssProvider(); prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        pane = Gtk.Box(); self.add(pane)
        side = Gtk.ScrolledWindow(); side.set_size_request(250, -1); side.get_style_context().add_class("side")
        self.list = Gtk.ListBox(); side.add(self.list); pane.pack_start(side, False, False, 0)
        self.rows = {}
        last = None
        for tid, cat, name, *_ in TOOLS:
            if cat != last:
                h = Gtk.Label(label=cat.upper(), xalign=0); h.get_style_context().add_class("cat")
                r = Gtk.ListBoxRow(); r.add(h); r.set_selectable(False); r.set_activatable(False); self.list.add(r); last = cat
            r = Gtk.ListBoxRow(); r.add(Gtk.Label(label=name, xalign=0, margin=6)); r.tool = tid; self.list.add(r); self.rows[tid] = r
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); self.body.set_border_width(18)
        pane.pack_start(self.body, True, True, 0)
        self.list.connect("row-selected", lambda _l, r: r is not None and hasattr(r, "tool") and self.open(r.tool))
        self.list.select_row(self.rows.get(start) or self.rows["large"])

    def open(self, tid):
        for c in self.body.get_children():
            self.body.remove(c)
        _, cat, name, help_, fields, fn = next(t for t in TOOLS if t[0] == tid)
        t = Gtk.Label(label=name, xalign=0); t.get_style_context().add_class("title"); self.body.pack_start(t, False, False, 0)
        h = Gtk.Label(label=help_, xalign=0); h.set_line_wrap(True); h.get_style_context().add_class("hint"); self.body.pack_start(h, False, False, 0)
        grid = Gtk.Grid(column_spacing=10, row_spacing=8); getters = {}
        for i, (key, kind) in enumerate(fields):
            grid.attach(Gtk.Label(label=key.capitalize(), xalign=1), 0, i, 1, 1)
            kind, _, default = kind.partition(":")
            if kind in ("file", "folder"):
                w = Gtk.FileChooserButton(title=key, action=Gtk.FileChooserAction.SELECT_FOLDER if kind == "folder" else Gtk.FileChooserAction.OPEN)
                w.set_current_folder(HOME); getters[key] = w.get_filename
            elif kind == "files":
                store = []; lab = Gtk.Label(label="none chosen", xalign=0)
                def pick(_b, store=store, lab=lab):
                    d = Gtk.FileChooserDialog(title="Choose files (order = order chosen)", parent=self, action=Gtk.FileChooserAction.OPEN)
                    d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Add", Gtk.ResponseType.OK); d.set_select_multiple(True)
                    if d.run() == Gtk.ResponseType.OK:
                        store.extend(d.get_filenames()); lab.set_text(", ".join(os.path.basename(f) for f in store))
                    d.destroy()
                w = Gtk.Box(spacing=6); b = Gtk.Button(label="Add files..."); b.connect("clicked", pick)
                w.pack_start(b, False, False, 0); w.pack_start(lab, True, True, 0); getters[key] = lambda s=store: list(s)
            elif kind == "save":
                w = Gtk.Entry(text=os.path.join(HOME, "Documents", default)); getters[key] = w.get_text
            elif kind == "choice":
                w = Gtk.ComboBoxText()
                for o in default.split(","):
                    w.append_text(o)
                w.set_active(0); getters[key] = w.get_active_text
            else:
                w = Gtk.Entry(text=default); getters[key] = w.get_text
            w.set_hexpand(True); grid.attach(w, 1, i, 1, 1)
        self.body.pack_start(grid, False, False, 0)
        run = Gtk.Button(label="Run"); run.get_style_context().add_class("run"); run.set_halign(Gtk.Align.START)
        self.body.pack_start(run, False, False, 0)
        sw = Gtk.ScrolledWindow(); view = Gtk.TextView(editable=False, wrap_mode=Gtk.WrapMode.WORD_CHAR); sw.add(view)
        self.body.pack_start(sw, True, True, 0); out = Out(view)

        def go(_b):
            values = {k: g() for k, g in getters.items()}
            out.clear(); run.set_sensitive(False)
            def work():
                try:
                    fn(values, out)
                except Exception as e:  # real error shown to the user
                    out.write(f"Error: {e}")
                GLib.idle_add(run.set_sensitive, True)
            threading.Thread(target=work, daemon=True).start()
        run.connect("clicked", go)
        self.body.show_all()


if __name__ == "__main__":
    Win(sys.argv[1] if len(sys.argv) > 1 else None).show_all()
    Gtk.main()
