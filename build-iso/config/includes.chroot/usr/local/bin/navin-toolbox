        out.write("Your picture now shows on the login and lock screen.")


def t_speedtest(v, out):
    import urllib.request
    out.write("Measuring download speed (25 MB from Cloudflare) ...")
    t, got = time.monotonic(), 0
    try:
        req = urllib.request.Request(T.SPEED_URL.format(25_000_000), headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) NAVIN-Toolbox/2.2"})
        with urllib.request.urlopen(req, timeout=30) as r:
            while chunk := r.read(1 << 16):
                got += len(chunk)
                if time.monotonic() - t > 20:
                    break
    except OSError as e:
        out.write(f"No internet: {e}"); return
    secs = time.monotonic() - t
    out.write(f"Download: {T.mbit_per_s(got, secs)} Mbit/s  ({T.human_size(got)} in {secs:.1f} s)")
    ms = T.dns_time_ms("1.1.1.1")
    out.write(f"Response time (DNS 1.1.1.1): {ms} ms" if ms else "DNS did not answer.")


