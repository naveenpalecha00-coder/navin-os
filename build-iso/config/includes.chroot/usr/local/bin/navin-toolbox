def history():
    f = DATA / "history.csv"
    return T.parse_history(f.read_text()) if f.exists() else []


def show_hist(out, rows, key, unit, label):
    s = T.summarize_history(rows, key)
    if not s:
        out.write(f"No {label} history yet (a sample is taken every 5 minutes)."); return
    out.write(f"{label}: now {rows[-1][key] if rows[-1][key] is not None else '-'}{unit}, lowest {s['min']}{unit}, highest {s['max']}{unit}, average {s['avg']}{unit} ({s['samples']} samples)")
    for r in rows[-36:]:
        if r[key] is not None:
            out.write(f"{time.strftime('%d %b %H:%M', time.localtime(r['time']))}  {'#' * int(r[key] / 2.5):40} {r[key]}{unit}")


def t_bathist(v, out):
    rows = history(); show_hist(out, rows, "battery", "%", "Battery")
    d = T.battery_drain_per_hour(rows)
    if d:
        out.write(f"\nOn battery you use about {d}% per hour (about {round(100 / d, 1)} hours from full).")


def t_ramcpu(v, out):
    rows = history(); show_hist(out, rows, "ram", "%", "RAM used"); out.write(""); show_hist(out, rows, "cpu", "%", "CPU load")


def t_wifihist(v, out):
    show_hist(out, history(), "wifi", "%", "Wi-Fi signal")


