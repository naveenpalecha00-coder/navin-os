def t_repos(v, out):
    for f in sorted(pathlib.Path("/etc/apt/sources.list.d").glob("*.sources")) + [pathlib.Path("/etc/apt/sources.list")]:
        if f.exists():
            out.write(f"== {f}")
            if f.suffix == ".sources":
                for r in T.parse_sources(f.read_text()):
                    out.write(f"  {'off' if r.get('Enabled') == 'no' else 'on '}  {r.get('URIs')}  {r.get('Suites')}  {r.get('Components')}")
            else:
                out.write("\n".join("  " + l for l in f.read_text().splitlines() if l.strip() and not l.startswith("#")))
    out.write("\nTo add or switch off a repository: Synaptic > Settings > Repositories.")


def t_deps(v, out):
