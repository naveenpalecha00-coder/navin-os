    run_cmd(["apt-cache", "depends", "--important", v["package"]], out)
    out.write("\nNeeded by:"); run_cmd(["apt-cache", "rdepends", "--installed", v["package"]], out)
    out.write("\nBroken packages on this system:"); run_cmd(["apt-get", "check"], out, "none - all dependencies are fine.")


def t_grub(v, out):
    f = pathlib.Path("/etc/default/grub.d/navin.cfg")
    if not f.exists():
        f = pathlib.Path("/etc/default/grub")
    if os.path.exists("/run/live"):
        out.write("Live Mode: the boot menu is on the USB. This setting is for installed NAVIN."); return
    text = f.read_text()
    if v.get("menu seconds"):
        new = T.grub_set(text, timeout=v["menu seconds"], quiet={"logo (quiet)": True, "text messages": False}.get(v["boot screen"]))
        tmp = os.path.join(tempfile.gettempdir(), "navin-grub.cfg"); pathlib.Path(tmp).write_text(new)
        run_cmd(["pkexec", "sh", "-c", f"install -m 644 {tmp} {f} && update-grub"], out, "Boot menu updated.", timeout=300)
    out.write(pathlib.Path(f).read_text())


def t_compat(v, out):
    need(v, "file")
    with open(v["file"], "rb") as fh:
        head = fh.read(4096)
    verdict, text = T.compat_verdict(v["file"], head)
    out.write({"yes": "WORKS", "maybe": "PROBABLY WORKS", "no": "DOES NOT WORK", "unknown": "?"}[verdict] + f": {text}")
    if v["file"].lower().endswith(".deb"):
        run_cmd(["dpkg-deb", "-f", v["file"], "Package", "Version", "Architecture", "Depends"], out)


def t_maintain(v, out):
    import psutil
    du = psutil.disk_usage("/")
    failed = [l.split()[0] for l in sh(["systemctl", "--failed", "--no-legend", "--plain"]).splitlines() if l.strip()]
    cache = sum(s for _, s in T.walk_files(os.path.join(HOME, ".cache"))) if os.path.isdir(os.path.join(HOME, ".cache")) else 0
    upd = len([l for l in sh(["apt", "list", "--upgradable"]).splitlines() if "/" in l])
    todo = T.maintenance_plan(du.free, du.total, failed, cache, upd)
    out.write(f"Disk: {T.human_size(du.free)} free of {T.human_size(du.total)} · Updates waiting: {upd} · Failed services: {len(failed)}")
    for key, text in todo:
        out.write(f"TODO  {text}")
    if not todo:
        out.write("Everything is fine. Nothing to do."); return
    if confirm("Fix these now? (cleans cache; updates open the Update Center)"):
        if any(k in ("cache", "disk") for k, _ in todo):
            t_cache({"level": "everything" if any(k == "disk" for k, _ in todo) else "old files"}, out)
        if any(k == "updates" for k, _ in todo):
            subprocess.Popen(["navin-updater"])
        if failed:
            out.write("Failed services: see Toolbox > Service Manager or System Center > Repair.")


