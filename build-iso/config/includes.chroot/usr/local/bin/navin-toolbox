def t_parental(v, out):
    hosts = pathlib.Path("/etc/hosts").read_text()
    if v.get("action") != "show":
        sites = [] if v["action"] == "unblock all" else sorted(set(T.blocked_sites(hosts)) | set((v.get("websites") or "").replace(",", " ").split()))
        tmp = os.path.join(tempfile.gettempdir(), "navin-hosts"); pathlib.Path(tmp).write_text(T.hosts_block(hosts, sites))
        if run_cmd(["pkexec", "sh", "-c", f"install -m 644 {tmp} /etc/hosts && resolvectl flush-caches 2>/dev/null; true"], out):
            hosts = pathlib.Path("/etc/hosts").read_text()
    b = T.blocked_sites(hosts)
    out.write("Blocked for every user on this PC: " + (", ".join(b) if b else "nothing"))
    out.write("Tip: give children their own account without administrator rights so they cannot undo this.")


def t_schedule(v, out):
    unitdir = pathlib.Path(HOME, ".config/systemd/user"); unitdir.mkdir(parents=True, exist_ok=True)
    if v["type"] == "backup Documents/Pictures/Desktop":
        need(v, "folder")
        name, desc = "backup", "NAVIN scheduled backup"
        cmd = T.backup_command([os.path.join(HOME, d) for d in ("Documents", "Pictures", "Desktop")], os.path.join(v["folder"], "NAVIN Backup"))
    else:
        need(v, "command")
        name, desc, cmd = "task-" + time.strftime("%H%M%S"), "NAVIN automation: " + v["command"][:60], v["command"]
    for fn, text in T.user_timer_units(name, cmd, v.get("when") or "daily", desc).items():
        (unitdir / fn).write_text(text)
    run_cmd(["systemctl", "--user", "daemon-reload"], out)
    if run_cmd(["systemctl", "--user", "enable", "--now", f"navin-auto-{name}.timer"], out):
        out.write(f"Scheduled ({v.get('when') or 'daily'}). If the PC was off, it runs at the next start.")
    out.write(sh(["systemctl", "--user", "list-timers", "navin-auto-*", "--no-pager"]))



def t_open(prog, *args):
    def fn(v, out):
        if not which(prog):
            out.write(f"'{prog}' is not installed."); return
        subprocess.Popen([prog, *args]); out.write(f"Opened {prog}.")
    return fn



