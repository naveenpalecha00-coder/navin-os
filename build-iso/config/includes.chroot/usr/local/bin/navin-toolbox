button.run { background: #1677F2; color: #FFF; border-radius: 8px; padding: 6px 18px; }
"""


def which(prog):
    return shutil.which(prog) is not None


class Out:
    """Thread-safe output box."""
    def __init__(self, view):
        self.buf = view.get_buffer()

    def clear(self):
        GLib.idle_add(lambda: self.buf.set_text("") or False)

    def write(self, text):
        def add():
            self.buf.insert(self.buf.get_end_iter(), text if text.endswith("\n") else text + "\n")
            return False
        GLib.idle_add(add)


def run_cmd(cmd, out, ok_msg=None, timeout=None):
    prog = cmd[1] if cmd[0] == "pkexec" else cmd[0]
    if not which(prog):
        out.write(f"'{prog}' is not installed on this system.")
        return False
    out.write("$ " + " ".join(cmd))
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        out.write("Stopped: took too long.")
        return False
    if p.stdout.strip():
        out.write(p.stdout.strip()[:20000])
    if p.returncode != 0:
        out.write((p.stderr.strip() or f"failed (exit {p.returncode})")[:4000])
        return False
    if ok_msg:
        out.write(ok_msg)
    return True


def need(v, *keys):
    for k in keys:
        if not v.get(k):
            raise ValueError(f"Please choose: {k}")


# ---------------- tools (id, category, name, help, fields, function) ----------------

def t_large(v, out):
    need(v, "folder")
    out.write(f"Scanning {v['folder']} for files over {v['min MB']} MB ...")
    res = T.large_files(T.walk_files(v["folder"]), int(v["min MB"] or 100) * 1024 * 1024)
    out.write("\n".join(f"{T.human_size(s):>10}  {p}" for p, s in res) or "No files that large.")


def t_dupes(v, out):
    need(v, "folder")
    out.write("Comparing files with the same size by SHA-256 ...")
    groups = T.duplicate_groups(list(T.walk_files(v["folder"])), min_bytes=1024)
    if not groups:
        out.write("No duplicate files found."); return
    waste = sum(s * (len(g) - 1) for s, g in groups)
    out.write(f"{len(groups)} groups, {T.human_size(waste)} could be freed by keeping one copy of each:")
    for s, g in groups[:200]:
        out.write(f"\n{T.human_size(s)}:\n  " + "\n  ".join(g))


def t_sizes(v, out):
    need(v, "folder")
    for name, s in T.folder_sizes(v["folder"], T.walk_files(v["folder"]))[:60]:
        out.write(f"{T.human_size(s):>10}  {'#' * max(1, min(40, int(s / max(1, 1 << 24))))}  {name}")


def t_search(v, out):
    need(v, "folder", "text")
    run_cmd(T.content_search_cmd(v["folder"], v["text"]), out, timeout=300) or out.write("No file contains that text.")


def t_checksum(v, out):
    need(v, "file")
    for algo in ("md5", "sha1", "sha256"):
        out.write(f"{algo.upper():7} {T.file_hash(v['file'], algo)}")


def t_shred(v, out):
    need(v, "file")
    if not T.safe_user_path(v["file"], HOME):
        out.write("Only your own files (home folder or USB drives) can be shredded."); return
    if confirm(f"Destroy {os.path.basename(v['file'])} permanently? It cannot be recovered."):
        run_cmd(T.shred_cmd(v["file"]), out, "File overwritten and deleted.")


def t_organize(v, out):
    folder = v.get("folder") or os.path.join(HOME, "Downloads")
    if not T.safe_user_path(folder, HOME):
        out.write("Choose a folder inside your home folder."); return
    names = [n for n in os.listdir(folder) if os.path.isfile(os.path.join(folder, n))]
    existing = [f"{c}/{n}" for c in T.CATEGORIES if os.path.isdir(os.path.join(folder, c)) for n in os.listdir(os.path.join(folder, c))]
    plan = T.organize_plan(names, existing)
    for old, new in plan:
        os.makedirs(os.path.join(folder, os.path.dirname(new)), exist_ok=True)
        os.rename(os.path.join(folder, old), os.path.join(folder, new))
        out.write(f"{old}  ->  {new}")
    out.write(f"{len(plan)} files sorted." if plan else "Nothing to sort.")


def t_rename(v, out):
    need(v, "folder", "pattern")
    folder = v["folder"]
    names = [n for n in os.listdir(folder) if os.path.isfile(os.path.join(folder, n)) and not n.startswith(".")]
    plan = T.batch_rename_plan(names, v["pattern"], int(v.get("start") or 1))
    clash = [n for o, n in plan if os.path.exists(os.path.join(folder, n)) and n not in names]
    if clash:
        out.write("Stopped: these names already exist: " + ", ".join(clash[:10])); return
    tmp = [(o, n, f".navin-rename-{i}") for i, (o, n) in enumerate(plan)]
    for o, n, t in tmp:
        os.rename(os.path.join(folder, o), os.path.join(folder, t))
    for o, n, t in tmp:
        os.rename(os.path.join(folder, t), os.path.join(folder, n)); out.write(f"{o}  ->  {n}")


def t_pdf_merge(v, out):
    files = v.get("files") or []
    need(v, "save")
    run_cmd(T.pdf_merge_cmd(files, v["save"]), out, f"Saved {v['save']}")


def t_pdf_split(v, out):
    need(v, "file")
    run_cmd(T.pdf_split_cmd(v["file"], os.path.dirname(v["file"])), out, "Pages saved next to the original PDF.")


def t_pdf_compress(v, out):
    need(v, "file")
    dst = os.path.splitext(v["file"])[0] + f"-{v['level']}.pdf"
    if run_cmd(T.pdf_compress_cmd(v["file"], dst, v["level"]), out):
        out.write(f"{T.human_size(os.path.getsize(v['file']))} -> {T.human_size(os.path.getsize(dst))}  ({dst})")


def t_image(v, out):
    need(v, "file", "format")
    dst = os.path.splitext(v["file"])[0] + (f"-{v['width']}px" if v.get("width") else "-converted") + "." + v["format"]
    run_cmd(T.image_convert_cmd(v["file"], dst, v.get("width") or None), out, f"Saved {dst}")


def t_trim(v, out):
    need(v, "file", "start", "end")
    base, ext = os.path.splitext(v["file"])
    run_cmd(T.video_trim_cmd(v["file"], f"{base}-trim{ext}", v["start"], v["end"]), out, f"Saved {base}-trim{ext}")


def t_record(v, out):
    dst = os.path.join(HOME, "Music", time.strftime("Recording %Y-%m-%d %H-%M-%S.ogg"))
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    out.write(f"Recording {v['seconds']} s from the microphone ...")
    run_cmd(T.audio_record_cmd(dst, v["seconds"]), out, f"Saved {dst}")


def t_webcam(v, out):
    if not list(pathlib.Path("/dev").glob("video*")):
        out.write("No camera found on this computer."); return
    subprocess.Popen(["guvcview"]); out.write("Camera preview opened.")


def t_dns(v, out):
    host = v.get("text") or "debian.org"
    for name, ip in T.DNS_SERVERS:
        ms = T.dns_time_ms(ip, host)
        out.write(f"{name:11} {ip:16} {'%6.1f ms' % ms if ms is not None else '  no answer'}")


def t_netuse(v, out):
    import psutil
    a = psutil.net_io_counters(pernic=True); time.sleep(5); b = psutil.net_io_counters(pernic=True)
    for nic in b:
        if nic == "lo" or nic not in a:
            continue
        down = T.rate(a[nic].bytes_recv, b[nic].bytes_recv, 5); up = T.rate(a[nic].bytes_sent, b[nic].bytes_sent, 5)
        out.write(f"{nic:10} down {T.human_size(down)}/s   up {T.human_size(up)}/s   total since boot {T.human_size(b[nic].bytes_recv)} / {T.human_size(b[nic].bytes_sent)}")


def t_wifiqr(v, out):
    ssid = subprocess.run(["nmcli", "-t", "-f", "active,ssid", "dev", "wifi"], capture_output=True, text=True).stdout
    ssid = next((l.split(":", 1)[1] for l in ssid.splitlines() if l.startswith("yes:")), "")
    if not ssid:
        out.write("Not connected to Wi-Fi."); return
    pw = subprocess.run(["nmcli", "-s", "-g", "802-11-wireless-security.psk", "connection", "show", ssid], capture_output=True, text=True).stdout.strip()
    png = os.path.join(GLib.get_user_runtime_dir() or "/tmp", "navin-wifi-qr.png")
    if run_cmd(["qrencode", "-s", "10", "-o", png, T.wifi_qr_payload(ssid, pw)], out):
        GLib.idle_add(show_image, png, f"Scan to join {ssid}"); out.write(f"QR code for {ssid} shown. Phones join by scanning it.")


def t_nettrouble(v, out):
    gw = subprocess.run(["ip", "route", "show", "default"], capture_output=True, text=True).stdout.split()
    gw = gw[2] if len(gw) > 2 else ""
    out.write("1. Network connection: " + ("router " + gw if gw else "NOT connected (connect Wi-Fi or cable)"))
    if gw:
        out.write("2. Router reachable: " + ("yes" if subprocess.run(["ping", "-c", "2", "-W", "2", gw], capture_output=True).returncode == 0 else "NO"))
    out.write("3. Internet (1.1.1.1): " + ("yes" if subprocess.run(["ping", "-c", "2", "-W", "3", "1.1.1.1"], capture_output=True).returncode == 0 else "NO"))
    ms = T.dns_time_ms("1.1.1.1")
    out.write("4. Name lookup (DNS): " + (f"works ({ms} ms)" if ms else "NOT working - try Settings > Network > DNS 1.1.1.1"))
    import urllib.request
    try:
        with urllib.request.urlopen(T.CAPTIVE_URL, timeout=6) as r:
            body = r.read(512).decode(errors="replace")
    except OSError:
        body = None
    if body is not None and T.captive_portal(body):
        out.write("5. Wi-Fi login page: YES - this Wi-Fi wants you to sign in. Opening the login page ...")
        subprocess.Popen(["xdg-open", "http://neverssl.com"])
    elif body is not None:
        out.write("5. Wi-Fi login page: not needed")


def t_boot(v, out):
    p = subprocess.run(["systemd-analyze"], capture_output=True, text=True); out.write(p.stdout.strip() or p.stderr.strip())
    b = subprocess.run(["systemd-analyze", "blame"], capture_output=True, text=True).stdout
    out.write("\nSlowest start-up items:")
    for s, u in T.parse_blame(b):
        out.write(f"{s:8.2f} s  {u}")


def t_services(v, out):
    if v.get("service") and v.get("action") != "show":
        run_cmd(T.service_cmd(v["action"], v["service"]), out, f"{v['action']} {v['service']}: done")
    text = subprocess.run(["systemctl", "list-units", "--type=service", "--all", "--no-legend", "--plain"], capture_output=True, text=True).stdout
    for unit, active, sub, desc in T.parse_services(text):
        out.write(f"{active:9} {sub:9} {unit:40} {desc}")


def t_kernel(v, out):
    u = os.uname(); out.write(f"Kernel  : {u.release}\nBuilt   : {u.version}\nMachine : {u.machine}")
    out.write("Boot options: " + pathlib.Path("/proc/cmdline").read_text().strip())
    run_cmd(["lsmod"], out)


def t_logs(v, out):
    run_cmd(["journalctl", "-b", "-p", "3", "--no-pager", "-n", "300"], out) or out.write("Tip: errors need the 'adm' group or administrator rights.")


def t_battery(v, out):
    bats = [b for b in pathlib.Path("/sys/class/power_supply").glob("BAT*")]
    if not bats:
        out.write("No battery found (desktop PC or battery removed)."); return
    rd = lambda b, n: (b / n).read_text().strip() if (b / n).exists() else None
    for b in bats:
        full = rd(b, "energy_full") or rd(b, "charge_full"); design = rd(b, "energy_full_design") or rd(b, "charge_full_design")
        h = T.battery_health(full, design)
        out.write(f"{b.name}: {rd(b, 'status')}, {rd(b, 'capacity')}% charged, health {f'{h}% of new' if h else 'not reported by this battery'}, cycles {rd(b, 'cycle_count') or '-'}")


def t_disk(v, out):
    disks = [l.split()[0] for l in subprocess.run(["lsblk", "-dno", "NAME,TYPE"], capture_output=True, text=True).stdout.splitlines() if l.endswith("disk")]
    for d in disks:
        run_cmd(["pkexec", "smartctl", "-H", "-A", f"/dev/{d}"], out, timeout=60)


def t_usb(v, out):
    run_cmd(["lsusb"], out)


def t_report(v, out):
    import psutil
    grab = lambda c: subprocess.run(c, capture_output=True, text=True).stdout if which(c[0]) else ""
    sections = [("System", grab(["fastfetch", "--pipe"]) or grab(["uname", "-a"])),
                ("Memory", f"RAM {T.human_size(psutil.virtual_memory().total)}, used {psutil.virtual_memory().percent}%  swap/ZRAM used {psutil.swap_memory().percent}%"),
                ("Disks", grab(["df", "-h", "-x", "tmpfs", "-x", "devtmpfs", "-x", "squashfs"])),
                ("Start-up", grab(["systemd-analyze"])), ("Failed services", grab(["systemctl", "--failed", "--no-legend"])),
                ("Hardware fixes", grab(["navin-hwdetect"])), ("Touchpad", grab(["navin-touchpad", "doctor"])),
                ("Errors this boot", grab(["journalctl", "-b", "-p", "3", "--no-pager", "-n", "80"]))]
    dst = os.path.join(HOME, "Documents", time.strftime("NAVIN health report %Y-%m-%d %H-%M.txt"))
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    pathlib.Path(dst).write_text(T.health_report(sections)); out.write(f"Report saved: {dst}")
    subprocess.Popen(["xdg-open", dst])


def t_pomodoro(v, out):
    rounds = int(v.get("rounds") or 4) * 2
    for i in range(rounds):
        name, secs = T.pomodoro_step(i)
        out.write(f"{time.strftime('%H:%M')}  {name} for {secs // 60} minutes")
        subprocess.run(["notify-send", "-i", "alarm-symbolic", "Pomodoro", f"{name}: {secs // 60} minutes"])
        time.sleep(secs)
    subprocess.run(["notify-send", "Pomodoro", "All rounds finished. Well done!"]); out.write("Finished.")


def t_focus(v, out):
    cur = subprocess.run(["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb"], capture_output=True, text=True).stdout.strip() == "true"
    new = "false" if cur else "true"
    subprocess.run(["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb", "-n", "-t", "bool", "-s", new])
    out.write("Focus mode ON: notifications are silent." if new == "true" else "Focus mode OFF: notifications are back.")


def t_ontop(v, out):
    out.write("Click the window that should stay on top (click it again later and run this tool to undo).")
    run_cmd(["wmctrl", "-r", ":SELECT:", "-b", "toggle,above"], out, "Done: that window now toggles always-on-top.")


def t_keys(v, out):
    GLib.idle_add(key_tester)


# ======================= NAVIN 2.2 tools =======================
DATA = pathlib.Path(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share"))) / "navin"
CONF = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))) / "navin"


def sh(cmd, timeout=60):
    """Output of a read-only command ('' when it is missing)."""
    if not which(cmd[0]):
        return ""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except subprocess.TimeoutExpired:
        return ""


def recent():
    f = pathlib.Path(HOME, ".local/share/recently-used.xbel")
    return T.parse_recent(f.read_text(errors="replace")) if f.exists() else []


def t_suggest(v, out):
    apps = T.app_suggestions(recent())
    if not apps:
        out.write("No history yet. Open some files and come back - suggestions come from what you really use."); return
    out.write("Your most used apps (from the files you opened):")
    for a, c in apps:
        out.write(f"{c:5}x  {a}")


def t_activity(v, out):
    rows = recent()[:int(v.get("show") or 50)]
    out.write("\n".join(f"{m[:16].replace('T', ' ')}  {p}" for p, m, _ in rows) or "No recent files.")


def t_voice(v, out):
    if not which("pocketsphinx"):
        out.write("Voice search needs the offline speech package 'pocketsphinx' (App Store > search pocketsphinx)."); return
    wav = os.path.join(tempfile.gettempdir(), "navin-voice.wav")
    out.write("Speak now (5 seconds) ...")
    if not run_cmd(["ffmpeg", "-y", "-loglevel", "error", "-f", "pulse", "-i", "default", "-t", "5", "-ac", "1", "-ar", "16000", wav], out):
        return
    q = T.voice_query(sh(["pocketsphinx", "single", wav], timeout=120))
    if not q:
        out.write("Nothing understood. Speak a little louder, in English."); return
    out.write(f"You said: {q}")
    subprocess.Popen(["navin-search", q])


def t_arrange(v, out):
    desk = sh(["xdotool", "get_desktop"]).strip()
    wins = [w for w in T.parse_wmctrl(sh(["wmctrl", "-lpG"])) if str(w[1]) == desk]
    geo = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)
    wa = geo.get_workarea()
    cells = T.tile_layout(len(wins), wa.width, wa.height, wa.y)
    for (wid, *_), (x, y, w, h) in zip(wins, cells):
        subprocess.run(["wmctrl", "-ir", wid, "-b", "remove,maximized_vert,maximized_horz"])
        subprocess.run(["wmctrl", "-ir", wid, "-e", f"0,{wa.x + x},{y},{w},{h}"])
    out.write(f"{len(wins)} windows arranged side by side." if wins else "No windows open on this desktop.")


def t_profiles(v, out):
    src = pathlib.Path(HOME, ".config/xfce4/xfconf/xfce-perchannel-xml")
    name, act = v.get("name") or "", v.get("action")
    base = CONF / "profiles"
    if act == "list":
        out.write("\n".join(sorted(p.name for p in base.glob("*") if p.is_dir())) or "No profiles saved yet."); return
    if not T.profile_name_ok(name):
        out.write("Profile name: letters, numbers, space, - or _ (max 40)."); return
    dst = base / name
    if act == "save":
        dst.mkdir(parents=True, exist_ok=True)
        subprocess.run(["xfconf-query", "-c", "xfce4-panel", "-p", "/panels", "-l"], capture_output=True)  # flush
        for ch in T.PROFILE_CHANNELS:
            if (src / ch).exists():
                shutil.copy2(src / ch, dst / ch)
        out.write(f"Saved desktop profile '{name}' (wallpaper, panel, theme, windows, shortcuts).")
    elif act == "load":
        if not dst.is_dir():
            out.write("No profile with that name."); return
        subprocess.run(["pkill", "-x", "xfconfd"])
        for ch in T.PROFILE_CHANNELS:
            if (dst / ch).exists():
                shutil.copy2(dst / ch, src / ch)
        subprocess.Popen(["xfce4-panel", "-r"]); subprocess.Popen(["xfdesktop", "--reload"]); subprocess.Popen(["xfwm4", "--replace"])
        out.write(f"Profile '{name}' loaded.")


def t_clipslots(v, out):
    base = CONF / "clipboard"; base.mkdir(parents=True, exist_ok=True)
    path = T.clip_slot_path(base, v.get("slot") or 1)
    if v.get("action") == "save current clipboard":
        text = sh(["xclip", "-o", "-selection", "clipboard"])
        if not text:
            out.write("The clipboard is empty (copy some text first)."); return
        pathlib.Path(path).write_text(text); out.write(f"Slot {v['slot']} saved ({len(text)} characters).")
    elif v.get("action") == "put slot into clipboard":
        if not os.path.exists(path):
            out.write("That slot is empty."); return
        subprocess.run(["xclip", "-selection", "clipboard"], input=pathlib.Path(path).read_text(), text=True)
        out.write(f"Slot {v['slot']} is in the clipboard - press Ctrl+V to paste.")
    for i in range(1, T.CLIP_SLOTS + 1):
        f = T.clip_slot_path(base, i)
        txt = pathlib.Path(f).read_text()[:60].replace("\n", " ") if os.path.exists(f) else "(empty)"
        out.write(f"Slot {i}: {txt}")


def t_recover(v, out):
    out.write("Deleted files: first look in the Trash (Files > Trash > right-click > Restore).")
    if not which("photorec"):
        out.write("Deep recovery needs 'testdisk' (App Store)."); return
    out.write("Opening PhotoRec: choose the drive, then a DIFFERENT drive to save recovered files to.")
    subprocess.Popen(["xfce4-terminal", "--title", "NAVIN File Recovery", "-x", "pkexec", "photorec"])


def t_convert(v, out):
    need(v, "folder", "format")
    folder = v["folder"]
    names = [n for n in os.listdir(folder) if os.path.isfile(os.path.join(folder, n))]
    plan = T.batch_convert_plan(names, v["format"])
    if not plan:
        out.write("No files of a matching type to convert."); return
    for old, new in plan:
        ok = run_cmd(T.media_convert_cmd(os.path.join(folder, old), os.path.join(folder, new)), out, timeout=3600)
        out.write(f"{'ok  ' if ok else 'FAIL'} {old} -> {new}")


def t_perms(v, out):
    need(v, "file")
    f = v["file"]
    if v.get("mode"):
        if not T.safe_user_path(f, HOME):
            out.write("Only your own files can be changed here."); return
        run_cmd(T.chmod_cmd(f, v["mode"]), out)
    st = os.stat(f)
    import pwd, grp
    out.write(f"{f}\nOwner: {pwd.getpwuid(st.st_uid).pw_name}   Group: {grp.getgrgid(st.st_gid).gr_name}\n{T.mode_text(st.st_mode & 0o777)}")


def t_join(v, out):
    files = v.get("files") or []
    need(v, "save")
    lst = os.path.join(tempfile.gettempdir(), "navin-join.txt")
    pathlib.Path(lst).write_text(T.video_join_list(files))
    run_cmd(T.video_join_cmd(lst, v["save"]), out, f"Saved {v['save']}", timeout=3600)


def t_library(v, out):
    for name in ("Pictures", "Videos", "Music", "Documents", "Downloads"):
        d = os.path.join(HOME, name)
        if os.path.isdir(d):
            lib = T.media_library(T.walk_files(d))
            out.write(f"{name}: " + (", ".join(f"{c} {n} ({T.human_size(b)})" for c, (n, b) in sorted(lib.items())) or "empty"))
    out.write("\nOpen a folder in Files to play or view; VLC plays music/videos, Ristretto shows pictures.")


