#!/bin/bash
# NAVIN Backup Center — back up / restore personal files to a USB drive or folder, with SHA-256 verification.
T="NAVIN Backup Center"
C=$(zenity --list --title="$T" --width=420 --height=260 --column=Option "Backup my files" "Restore a backup") || exit 0
if [[ "$C" == Backup* ]]; then
  D=$(zenity --file-selection --directory --title="Backup kahan save karein? (USB drive chuno)" --filename=/media/$USER/) || exit 0
  SEL=$(zenity --list --checklist --title="$T" --text="Kya backup karna hai?" --column=" " --column=Folder --separator=" " \
    TRUE Documents TRUE Pictures TRUE Desktop TRUE Downloads FALSE Music FALSE Videos FALSE .config) || exit 0
  F="$D/navin-backup-$(date +%Y%m%d-%H%M).tar.gz"
  (cd "$HOME" && tar -czf "$F" $SEL 2>/dev/null) | zenity --progress --pulsate --auto-close --no-cancel --title="$T" --text="Backup ban raha hai..."
  sha256sum "$F" > "$F.sha256"
  zenity --info --title="$T" --text="✅ Backup ready:\n$F\nSize: $(du -h "$F" | cut -f1)\nSHA-256 saved."
else
  F=$(zenity --file-selection --title="Backup file chuno" --file-filter="NAVIN backup | navin-backup-*.tar.gz") || exit 0
  if [ -f "$F.sha256" ] && ! (cd "$(dirname "$F")" && sha256sum -c "$(basename "$F").sha256" >/dev/null); then
    zenity --error --text="❌ Backup kharab hai (checksum match nahi hua)."; exit 1; fi
  zenity --question --text="Files $HOME me restore hongi. Same naam ki files replace hongi. Continue?" || exit 0
  tar -xzf "$F" -C "$HOME" | zenity --progress --pulsate --auto-close --no-cancel --text="Restore ho raha hai..."
  zenity --info --text="✅ Restore complete."
fi
