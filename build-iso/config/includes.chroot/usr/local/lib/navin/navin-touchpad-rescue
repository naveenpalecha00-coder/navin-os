#!/bin/bash
# NAVIN 2.0/2.1 name kept for older shortcuts; NAVIN 2.2.1 uses the repair engine.
#   navin-touchpad-rescue [run|reset|status]
case "${1:-run}" in
  reset) exec /usr/lib/navin-os/navin-touchpad-repair.sh driver restore-default;;
  status) exec /usr/lib/navin-os/navin-touchpad-repair.sh status;;
  *) exec /usr/lib/navin-os/navin-touchpad-repair.sh run --manual;;
esac
