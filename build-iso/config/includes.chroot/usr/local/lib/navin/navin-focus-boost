#!/usr/bin/python3
"""NAVIN OS Build 10: foreground app priority.
Event-driven (X PropertyNotify on _NET_ACTIVE_WINDOW, zero polling). The focused
app's process tree gets nice -5 + best-effort I/O class 0; the previously focused
app drops to nice 2. Only processes owned by the session user are touched."""
import os, subprocess, sys
from Xlib import X, display

USER_UID = int(os.environ.get('NAVIN_UID', os.getuid()))
FOCUS_NICE, BACKGROUND_NICE = -5, 2
SKIP = {'Xorg', 'xfwm4', 'xfce4-panel', 'picom', 'xfdesktop'}

def tree(pid):
    out, todo = [], [pid]
    while todo:
        p = todo.pop()
        try:
            if os.stat(f'/proc/{p}').st_uid != USER_UID: continue
            with open(f'/proc/{p}/comm') as f:
                if f.read().strip() in SKIP: continue
        except OSError:
            continue
        out.append(p)
        try:
            for t in os.listdir(f'/proc/{p}/task'):
                with open(f'/proc/{p}/task/{t}/children') as f:
                    todo += [int(c) for c in f.read().split()]
        except OSError:
            pass
    return out

def apply(pid, nice, ioprio):
    for p in tree(pid):
        try: os.setpriority(os.PRIO_PROCESS, p, nice)
        except OSError: pass
        subprocess.run(['ionice', '-c2', '-n', str(ioprio), '-p', str(p)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    d = display.Display(); root = d.screen().root
    active, wm_pid = d.intern_atom('_NET_ACTIVE_WINDOW'), d.intern_atom('_NET_WM_PID')
    root.change_attributes(event_mask=X.PropertyChangeMask)
    previous = None
    while True:
        ev = d.next_event()
        if ev.type != X.PropertyNotify or ev.atom != active: continue
        try:
            win = root.get_full_property(active, X.AnyPropertyType)
            if not win or not win.value[0]: continue
            prop = d.create_resource_object('window', win.value[0]).get_full_property(wm_pid, X.AnyPropertyType)
            pid = int(prop.value[0]) if prop else None
        except Exception:
            continue
        if not pid or pid == previous: continue
        if previous: apply(previous, BACKGROUND_NICE, 6)
        apply(pid, FOCUS_NICE, 0)
        previous = pid

if __name__ == '__main__':
    try: main()
    except KeyboardInterrupt: sys.exit(0)
