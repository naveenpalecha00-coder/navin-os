#!/bin/bash
set -u
case "${1:-}" in silent) profile=quiet; governor=powersave;; auto) profile=balanced; governor=schedutil;; turbo) profile=performance; governor=performance;; *) exit 2;; esac
ok=0
for path in /sys/firmware/acpi/platform_profile /sys/devices/platform/samsung-galaxybook/fan_mode; do
 [ -w "$path" ] || continue
 if [ "$path" = /sys/firmware/acpi/platform_profile ]; then
  choices=$(cat /sys/firmware/acpi/platform_profile_choices)
  if [ "$profile" = quiet ] && [[ " $choices " != *' quiet '* ]]; then profile=low-power; fi
  [[ " $choices " = *" $profile "* ]] && printf '%s' "$profile" > "$path" && ok=1
 else
  # Do not guess Samsung firmware's numeric modes; ACPI profile is preferred.
  echo 'Samsung fan_mode detected; unsupported numeric ABI, using CPU/ACPI control.' >&2
 fi
done
for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
 [ -w "$f" ] || continue
 choices=$(cat "${f%/*}/scaling_available_governors")
 [[ " $choices " = *" $governor "* ]] && printf '%s' "$governor" > "$f"
done
echo "$ok"
