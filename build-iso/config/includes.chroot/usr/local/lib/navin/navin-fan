#!/bin/bash
# NAVIN OS fan/thermal mode (root). Usage: navin-fan silent|auto|turbo
M=$1; ok=0
case $M in silent) gb=1; pp=low-power; sl=0; gov=powersave;; turbo) gb=2; pp=performance; sl=2; gov=performance;; *) gb=0; pp=balanced; sl=1; gov=schedutil;; esac
for f in /sys/devices/platform/samsung-galaxybook/fan_mode /sys/devices/platform/samsung-galaxybook/performance_mode; do [ -w "$f" ] && echo $gb > "$f" && ok=1; done
[ -w /sys/devices/platform/samsung/performance_level ] && echo $([ $sl = 0 ] && echo silent || ([ $sl = 2 ] && echo overclock || echo normal)) > /sys/devices/platform/samsung/performance_level && ok=1
if [ -w /sys/firmware/acpi/platform_profile ]; then
  ch=$(cat /sys/firmware/acpi/platform_profile_choices); case " $ch " in *" $pp "*) ;; *) [ $M = silent ] && pp=quiet; [ $M = auto ] && pp=balanced;; esac
  echo $pp > /sys/firmware/acpi/platform_profile 2>/dev/null && ok=1
fi
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo $gov > $g 2>/dev/null || echo powersave > $g 2>/dev/null; done
[ -e /sys/devices/system/cpu/intel_pstate/no_turbo ] && echo $([ $M = silent ] && echo 1 || echo 0) > /sys/devices/system/cpu/intel_pstate/no_turbo
for p in /sys/class/hwmon/hwmon*/pwm1; do [ -w "$p" ] || continue; echo 1 > ${p}_enable 2>/dev/null; echo $([ $M = silent ] && echo 90 || ([ $M = turbo ] && echo 255 || echo 160)) > $p && ok=1; done
echo $ok
