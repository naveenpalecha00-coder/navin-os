#!/bin/sh
# NAVIN OS 1.2: RAM-based profile before ZRAM starts. Thresholds match navin_hw.ram_profile().
# /etc/navin/memprofile may contain auto (default), lite, balanced or standard.
mem=$(awk '/MemTotal:/{print $2}' /proc/meminfo)
want=$(cat /etc/navin/memprofile 2>/dev/null || echo auto)
if [ "$want" = auto ]; then
  if [ "$mem" -le 2726297 ]; then want=lite; elif [ "$mem" -le 6815744 ]; then want=balanced; else want=standard; fi
fi
case "$want" in lite) pct=100;; balanced) pct=75;; *) want=standard; pct=50;; esac
printf 'ALGO=zstd\nPERCENT=%s\nPRIORITY=100\n' "$pct" > /etc/default/zramswap
mkdir -p /run/navin; echo "$want" > /run/navin/memprofile
