#!/bin/sh
# NAVIN OS 1.2: recover a touchpad that did not come back after suspend/resume.
[ "$1" = post ] || exit 0
sleep 2
grep -qiE 'touchpad|trackpad|glidepoint' /proc/bus/input/devices && exit 0
bus=$(jq -r '.touchpad.touchpads[0].bus // empty' /var/lib/navin/hardware.json 2>/dev/null)
case "$bus" in
  I2C|USB) modprobe -r hid_multitouch i2c_hid_acpi 2>/dev/null; modprobe i2c_hid_acpi; modprobe hid_multitouch ;;
  PS/2|RMI) modprobe -r psmouse 2>/dev/null; modprobe psmouse ;;
  *) exit 0 ;;
esac
echo "$(date '+%F %T') resume: reloaded $bus touchpad driver" >> /var/log/navin-hwdetect.log
