#!/bin/sh
# NAVIN 2.2.1: after suspend/resume, check the touchpad once and repair it only if it did not come back.
[ "$1" = post ] || exit 0
sleep 2
grep -qiE 'Phys=isa0060/serio[1-9]|touchpad|trackpad|glidepoint' /proc/bus/input/devices && exit 0
/usr/lib/navin-os/navin-touchpad-repair.sh run --resume >/dev/null 2>&1
exit 0
