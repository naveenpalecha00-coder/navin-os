{
 "version": "2.1",
 "items": [
  {
   "category": "Boot",
   "title": "Boot menu shows only two choices: Live Mode and Full Installation",
   "path": "build-iso/config/hooks/live/02-navin-bootmenu.hook.binary",
   "check": "two choices only"
  },
  {
   "category": "Boot",
   "title": "Safe Graphics (black-screen fix) moved into the Tools submenu",
   "path": "build-iso/config/hooks/live/02-navin-bootmenu.hook.binary",
   "check": "Tools (memory test, safe graphics)"
  },
  {
   "category": "Boot",
   "title": "Live USB boots with the PS/2 touchpad controller fix on every laptop",
   "path": "build-iso/auto/config",
   "check": "persistence i8042.nomux=1 i8042.reset=1"
  },
  {
   "category": "Boot",
   "title": "Installed system boots with the same touchpad controller fix",
   "path": "build-iso/config/includes.chroot/etc/default/grub.d/navin.cfg",
   "check": "GRUB_CMDLINE_LINUX_DEFAULT=\"i8042.nomux=1 i8042.reset=1"
  },
  {
   "category": "Touchpad",
   "title": "Touchpad is switched on again at every login (a stray toggle can't keep it off)",
   "path": "build-iso/config/includes.chroot/usr/local/bin/navin-touchpad",
   "check": "apply --login"
  },
  {
   "category": "Touchpad",
   "title": "Touchpads that appear late get their settings again 15 s after login",
   "path": "build-iso/config/includes.chroot/usr/local/bin/navin-session-init",
   "check": "sleep 15; navin-touchpad apply --login"
  },
  {
   "category": "Touchpad",
   "title": "Normal (not reversed) scrolling from the first second",
   "path": "build-iso/config/includes.chroot/etc/X11/xorg.conf.d/40-navin-touchpad.conf",
   "check": "\"NaturalScrolling\" \"false\""
  },
  {
   "category": "Speed",
   "title": "Background service checks USB every 2 s instead of 1.25 s",
   "path": "build-iso/config/includes.chroot/usr/local/lib/navin/navin-session-daemon",
   "check": "tick%8==0"
  },
  {
   "category": "Speed",
   "title": "Privacy (mic/camera) check every 15 s and skips the camera scan while the mic is in use",
   "path": "build-iso/config/includes.chroot/usr/local/lib/navin/navin-session-daemon",
   "check": "not active_mic and"
  },
  {
   "category": "Speed",
   "title": "Bluetooth earbud reconnect only runs when a Bluetooth adapter exists",
   "path": "build-iso/config/includes.chroot/usr/local/lib/navin/navin-session-daemon",
   "check": "has_bt and"
