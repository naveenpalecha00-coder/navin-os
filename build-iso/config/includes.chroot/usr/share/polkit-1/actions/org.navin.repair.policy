<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NAVIN OS</vendor>
  <action id="org.navin.repair">
    <description>Run a NAVIN OS system repair</description>
    <message>NAVIN AI System Doctor needs your password to repair the system</message>
    <icon_name>navin-os-logo</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/navin/navin-repair</annotate>
  </action>
  <action id="org.navin.touchpad-rescue">
    <description>Reset the NAVIN touchpad driver</description>
    <message>NAVIN needs your password to reset the touchpad driver</message>
    <icon_name>input-touchpad</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/navin/navin-touchpad-rescue</annotate>
  </action>
  <action id="org.navin.touchpad-repair">
    <description>Detect and repair the touchpad driver</description>
    <message>NAVIN needs your password to repair the touchpad driver</message>
    <icon_name>input-touchpad</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/navin-os/navin-touchpad-repair.sh</annotate>
  </action>
  <action id="org.navin.quirks">
    <description>Change NAVIN laptop compatibility fixes</description>
    <message>NAVIN needs your password to change the laptop compatibility fixes</message>
    <icon_name>input-touchpad</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/navin/navin-quirks</annotate>
  </action>
  <action id="org.navin.fan">
    <description>Change NAVIN fan and cooling settings</description>
    <message>NAVIN needs permission to change the fan speed</message>
    <icon_name>temperature</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/navin/navin-fan</annotate>
  </action>
  <action id="org.navin.update">
    <description>Install NAVIN XP updates</description>
    <message>NAVIN XP Update Center needs your password to check for and install updates</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/navin-os/navin-update-helper</annotate>
  </action>
</policyconfig>
