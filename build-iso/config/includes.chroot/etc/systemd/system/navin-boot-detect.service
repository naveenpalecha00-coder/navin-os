[Unit]
Description=NAVIN XP boot splash hardware line
After=systemd-udev-settle.service systemd-udevd.service plymouth-start.service
Before=lightdm.service
ConditionPathExists=/usr/bin/plymouth

[Service]
Type=oneshot
ExecStart=/usr/local/lib/navin/navin-boot-detect

[Install]
WantedBy=multi-user.target
